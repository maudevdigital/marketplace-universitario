# Variables para correr el backend FUERA de Docker (npm run start:dev).
# Copiar a backend/.env. Con Docker Compose no hace falta: usa el .env de la raíz.

# PostgreSQL y MongoDB levantados con «docker compose up postgres mongo» (puertos 5433 y 27018)
DATABASE_URL=postgresql://marketplace:cambiar-esta-clave@localhost:5433/marketplace
MONGO_URI=mongodb://localhost:27018/marketplace

# Frase larga y aleatoria para firmar las sesiones. Nunca subir la real al repositorio.
JWT_SECRET=cambiar-por-una-frase-larga-y-aleatoria
JWT_EXPIRA=8h

PORT=3000
# Direcciones del frontend que pueden llamar a la API, separadas por coma
CORS_ORIGEN=http://localhost:5173,http://localhost:8080
# Carpeta donde se guardan las imágenes que suben los usuarios
IMAGENES_DIR=./almacen/imagenes
