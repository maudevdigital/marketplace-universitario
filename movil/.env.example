# Normalmente no hace falta nada: la app usa la IP del computador donde corre Expo, puerto 3000.
# Copiar a .env.local y reiniciar Expo solo si:
# - la API está en otro puerto (el mismo PUERTO_API del .env de la raíz):
# EXPO_PUBLIC_API_PUERTO=3001
# - o el backend está en otra máquina (en Windows la IP se ve con «ipconfig», Dirección IPv4):
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
