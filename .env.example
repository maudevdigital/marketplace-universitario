# Copiar a .env antes de «docker compose up --build». Son valores de desarrollo, no reales.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=marketplace

# Frase larga y aleatoria para firmar las sesiones
JWT_SECRET=cambiar-por-una-frase-larga-y-aleatoria

# Puerto de la API en el computador (opcional, por defecto 3000). Si se cambia, poner el mismo
# en EXPO_PUBLIC_API_PUERTO de movil/.env.local.
# PUERTO_API=3001
